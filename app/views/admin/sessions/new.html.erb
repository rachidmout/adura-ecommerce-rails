<div class="admin-login"><div class="admin-login-card"><p class="eyebrow">Administration ADURA</p><h1>Connexion</h1><p class="muted">Aucune inscription publique n’est disponible.</p><%= form_with url: admin_login_path do |form| %><div class="field"><%= form.label :email, "Adresse e-mail" %><%= form.email_field :email, required: true, autocomplete: "email" %></div><div class="field"><%= form.label :password, "Mot de passe" %><%= form.password_field :password, required: true, autocomplete: "current-password" %></div><%= form.submit "Se connecter", class: "button button-primary", style: "width:100%" %><% end %></div></div>
