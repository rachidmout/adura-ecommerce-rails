<% if rows.any? %>
  <div class="admin-table-wrap"><table class="admin-table admin-table-wide"><thead><tr><th>Landing page</th><th>Sessions</th><th>Engagement</th><th>Achats GA4</th><th>Conversion</th><th>CA GA4</th></tr></thead><tbody><% rows.each do |row| %><tr><td><code><%= row[:path] %></code></td><td><%= row[:sessions] %></td><td><%= number_to_percentage(row[:engagement_rate], precision: 1, strip_insignificant_zeros: true) %></td><td><%= row[:purchases] %></td><td><%= row[:conversion_rate] ? number_to_percentage(row[:conversion_rate], precision: 2, strip_insignificant_zeros: true) : "—" %></td><td><%= number_to_currency(row[:revenue], unit: "€", format: "%n %u") %></td></tr><% end %></tbody></table></div>
<% else %><p class="admin-table-empty">Aucune donnée sur cette période.</p><% end %>
