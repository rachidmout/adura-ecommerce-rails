<% if rows.any? %>
  <div class="admin-table-wrap"><table class="admin-table admin-table-wide"><thead><tr><th>Produit</th><th>SKU</th><th>Vues</th><th>Ajouts panier</th><th>Achats GA4</th><th>Taux ajout</th><th>Taux achat</th><th>CA GA4</th></tr></thead><tbody><% rows.each do |row| %><tr><td><strong><%= row[:name] %></strong></td><td><%= row[:item_id] %></td><td><%= row[:views] %></td><td><%= row[:add_to_carts] %></td><td><%= row[:purchases] %></td><td><%= row[:cart_rate] ? number_to_percentage(row[:cart_rate], precision: 2, strip_insignificant_zeros: true) : "—" %></td><td><%= row[:purchase_rate] ? number_to_percentage(row[:purchase_rate], precision: 2, strip_insignificant_zeros: true) : "—" %></td><td><%= number_to_currency(row[:revenue], unit: "€", format: "%n %u") %></td></tr><% end %></tbody></table></div>
  <p class="admin-data-note">Les ventes et le CA officiels restent dans le tableau ADURA ci-dessous : les métriques GA4 dépendent du consentement.</p>
<% else %><p class="admin-table-empty">Aucune donnée sur cette période.</p><% end %>
