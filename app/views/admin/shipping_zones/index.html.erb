<div class="admin-title"><div><p class="eyebrow"><%= link_to "← Livraison", admin_shipping_configuration_path, class: "text-link" %></p><h1>Zones de livraison</h1></div><%= link_to "Nouvelle zone", new_admin_shipping_zone_path, class: "button button-primary" %></div>
<div class="admin-table-wrap"><table class="admin-table admin-table-wide"><thead><tr><th>Zone</th><th>État</th><th>Pays associés</th><th>Méthodes</th><th></th></tr></thead><tbody>
  <% @zones.each do |zone| %><tr><td><strong><%= zone.name %></strong></td><td><span class="status-pill <%= zone.active? ? "published" : "archived" %>"><%= zone.active? ? "Active" : "Inactive" %></span></td><td><%= zone.shipping_zone_countries.map { |country| ShippingZoneCountry::COUNTRIES[country.country_code] || country.country_code }.to_sentence.presence || "—" %></td><td><%= zone.shipping_methods.count %></td><td><%= link_to "Gérer", admin_shipping_zone_path(zone), class: "text-link" %></td></tr><% end %>
  <% if @zones.none? %><tr><td colspan="5" class="admin-table-empty"><p>Aucune zone de livraison.</p><%= link_to "Créer une zone", new_admin_shipping_zone_path, class: "button button-small button-primary" %></td></tr><% end %>
</tbody></table></div>
