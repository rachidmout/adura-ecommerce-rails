<div class="admin-title"><div><p class="eyebrow"><%= link_to "← Zones", admin_shipping_zones_path, class: "text-link" %></p><h1><%= @zone.name %></h1></div><div class="admin-title-actions"><span class="status-pill <%= @zone.active? ? "published" : "archived" %>"><%= @zone.active? ? "Active" : "Inactive" %></span><%= link_to "Modifier", edit_admin_shipping_zone_path(@zone), class: "button button-secondary" %><%= button_to @zone.active? ? "Désactiver" : "Activer", @zone.active? ? deactivate_admin_shipping_zone_path(@zone) : activate_admin_shipping_zone_path(@zone), method: :patch, class: "button button-secondary" %></div></div>

<section class="admin-panel"><div class="admin-panel-head"><div><h2>Pays associés</h2><p class="muted">Un pays ne peut appartenir qu’à une seule zone.</p></div></div>
  <div class="admin-country-list"><% @countries.each do |country| %><div><strong><%= ShippingZoneCountry::COUNTRIES[country.country_code] || country.country_code %></strong><code><%= country.country_code %></code><%= button_to "Retirer", admin_shipping_zone_shipping_zone_country_path(@zone, country), method: :delete, class: "text-link danger-link", data: { turbo_confirm: "Retirer ce pays de la zone ?" } %></div><% end %><% if @countries.none? %><p class="muted">Aucun pays associé.</p><% end %></div>
  <%= form_with model: [ :admin, @zone, ShippingZoneCountry.new ], class: "admin-inline-create" do |form| %><div class="field"><%= form.label :country_code, "Ajouter un pays" %><%= form.select :country_code, ShippingZoneCountry::COUNTRIES.map { |code, name| [ name, code ] }, { include_blank: "Choisir un pays" } %></div><%= form.submit "Ajouter", class: "button button-secondary" %><% end %>
</section>

<section class="admin-section"><div class="admin-section-head"><h2>Méthodes de livraison</h2><%= link_to "Nouvelle méthode", new_admin_shipping_zone_shipping_method_path(@zone), class: "text-link" %></div>
  <% if @methods.any? %><div class="admin-table-wrap"><table class="admin-table admin-table-wide"><thead><tr><th>Nom</th><th>Transporteur</th><th>Intégration</th><th>Seuil gratuité</th><th>Tarifs</th><th>État</th><th></th></tr></thead><tbody><% @methods.each do |shipping_method| %><tr><td><strong><%= shipping_method.name %></strong></td><td><%= shipping_method.carrier_name %></td><td><%= shipping_method.sendcloud? ? "Sendcloud" : "Directe" %></td><td><%= shipping_method.free_shipping_threshold_cents ? money(shipping_method.free_shipping_threshold_cents) : "—" %></td><td><%= shipping_method.shipping_rates.size %></td><td><span class="status-pill <%= shipping_method.active? ? "published" : "archived" %>"><%= shipping_method.active? ? "Active" : "Inactive" %></span></td><td><%= link_to "Gérer", edit_admin_shipping_zone_shipping_method_path(@zone, shipping_method), class: "text-link" %></td></tr><% end %></tbody></table></div><% else %><div class="admin-table-empty"><p>Aucune méthode de livraison.</p><%= link_to "Créer une méthode", new_admin_shipping_zone_shipping_method_path(@zone), class: "button button-small button-primary" %></div><% end %>
</section>

<section class="admin-section"><div class="admin-actions"><%= button_to "Supprimer la zone", admin_shipping_zone_path(@zone), method: :delete, class: "button button-danger", data: { turbo_confirm: "Supprimer cette zone vide ?" } %></div></section>
