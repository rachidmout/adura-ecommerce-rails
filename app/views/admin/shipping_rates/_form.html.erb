<%= form_with model: [:admin, @zone, @shipping_method, rate], class: "admin-form" do |form| %>
  <% if rate.errors.any? %><div class="error-summary"><ul><% rate.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="admin-form-grid">
    <div class="field"><%= form.label :min_weight_grams, "Poids minimum (g)" %><%= form.number_field :min_weight_grams, min: 0, required: true %></div>
    <div class="field"><%= form.label :max_weight_grams, "Poids maximum (g)" %><%= form.number_field :max_weight_grams, min: 1 %><small class="field-hint">Laissez vide pour la dernière tranche ouverte.</small></div>
    <div class="field"><%= form.label :price_euros, "Prix (€)" %><%= form.number_field :price_euros, value: rate.price_cents && rate.price_cents / 100.0, min: 0, step: 0.01, required: true %></div>
    <div class="field"><%= form.label :active, "Tarif actif" %><%= form.check_box :active %></div>
  </div>
  <div class="admin-actions"><%= form.submit "Enregistrer", class: "button button-primary" %><%= link_to "Annuler", edit_admin_shipping_zone_shipping_method_path(@zone, @shipping_method), class: "button button-secondary" %></div>
<% end %>
