<%
  # form_with model: [:admin, @product, variant] plante pour une variante
  # persistée : Rails déduit le nom d'helper depuis les classes du tableau
  # ("product" + route_key de ProductVariant, "product_variant") et obtient
  # admin_product_product_variant_path, qui n'existe pas (la route déclarée
  # dans routes.rb, nichée sous "resources :variants", s'appelle
  # admin_product_variant_path). URL explicite pour éviter cette inférence.
  variant_url = variant.persisted? ? admin_product_variant_path(@product, variant) : admin_product_variants_path(@product)
%>
<%= form_with model: variant, url: variant_url, class: "admin-form" do |form| %>
  <% if variant.errors.any? %>
    <div class="error-summary"><ul><% variant.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
  <% end %>
  <div class="admin-form-section">
    <div class="admin-section-head"><h2>Informations de la variante</h2><p>Le stock réservé est calculé automatiquement et ne peut pas être modifié ici.</p></div>
    <div class="admin-form-grid">
    <div class="field"><%= form.label :sku, "SKU" %><%= form.text_field :sku, placeholder: "Généré automatiquement si vide" %><small class="field-hint">Format : ADURA-<%= @product.slug.upcase %>-VOLUME. Vous pouvez le modifier.</small></div>
    <div class="field"><%= form.label :gtin, "GTIN / EAN" %><%= form.text_field :gtin %></div>
    <div class="field"><%= form.label :volume_ml, "Volume (ml)" %><%= form.number_field :volume_ml, min: 1, required: true %></div>
    <div class="field"><%= form.label :shipping_weight_grams, "Poids expédié (g)" %><%= form.number_field :shipping_weight_grams, min: 1 %><small class="field-hint">Poids du produit complet prêt à être emballé : flacon + bouchon + boîte.</small></div>
    <div class="field"><%= form.label :price_euros, "Prix TTC (€)" %><%= form.number_field :price_euros, min: 0, step: 0.01, required: true %></div>
    <div class="field"><%= form.label :stock_quantity, "Stock physique" %><%= form.number_field :stock_quantity, min: 0, required: true %></div>
    <div class="field"><label for="reserved-stock">Stock réservé</label><input id="reserved-stock" type="number" value="<%= variant.reserved_stock_quantity %>" disabled><small class="field-hint">Géré uniquement par les réservations Stripe.</small></div>
    <div class="field"><label for="available-stock">Stock disponible</label><input id="available-stock" type="number" value="<%= variant.available_stock_quantity %>" disabled></div>
    <div class="field"><%= form.label :position, "Position" %><%= form.number_field :position, min: 0 %></div>
    <div class="field"><%= form.label :currency, "Devise" %><%= form.select :currency, [ "EUR" ] %></div>
    <div class="field"><%= form.label :active, "Active" %><%= form.check_box :active %></div>
    </div>
  </div>
  <div class="admin-actions">
    <%= form.submit "Enregistrer", class: "button button-primary" %>
    <%= link_to "Annuler", edit_admin_product_path(@product), class: "button button-secondary" %>
  </div>
<% end %>
