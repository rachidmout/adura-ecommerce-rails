<div class="admin-title"><div><p class="eyebrow"><%= link_to "← #{@zone.name}", admin_shipping_zone_path(@zone), class: "text-link" %></p><h1><%= @shipping_method.name %></h1></div><div class="admin-title-actions"><span class="status-pill <%= @shipping_method.active? ? "published" : "archived" %>"><%= @shipping_method.active? ? "Active" : "Inactive" %></span><%= button_to @shipping_method.active? ? "Désactiver" : "Activer", @shipping_method.active? ? deactivate_admin_shipping_zone_shipping_method_path(@zone, @shipping_method) : activate_admin_shipping_zone_shipping_method_path(@zone, @shipping_method), method: :patch, class: "button button-secondary" %></div></div>
<%= render "form", shipping_method: @shipping_method %>

<section class="admin-section"><div class="admin-section-head"><h2>Tranches tarifaires</h2><%= link_to "Nouvelle tranche", new_admin_shipping_zone_shipping_method_shipping_rate_path(@zone, @shipping_method), class: "text-link" %></div>
  <% rates = @shipping_method.shipping_rates.order(:min_weight_grams) %>
  <% if rates.any? %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Poids</th><th>Prix</th><th>État</th><th></th></tr></thead><tbody><% rates.each do |rate| %><tr><td><%= rate.max_weight_grams ? "#{rate.min_weight_grams} g → #{rate.max_weight_grams} g" : "#{rate.min_weight_grams} g → ∞" %></td><td><%= money(rate.price_cents) %></td><td><span class="status-pill <%= rate.active? ? "published" : "archived" %>"><%= rate.active? ? "Active" : "Inactive" %></span></td><td><%= link_to "Modifier", edit_admin_shipping_zone_shipping_method_shipping_rate_path(@zone, @shipping_method, rate), class: "text-link" %><%= button_to "Supprimer", admin_shipping_zone_shipping_method_shipping_rate_path(@zone, @shipping_method, rate), method: :delete, class: "text-link danger-link", data: { turbo_confirm: "Supprimer cette tranche ?" } %></td></tr><% end %></tbody></table></div><% else %><div class="admin-table-empty"><p>Aucune tranche tarifaire.</p><%= link_to "Créer une tranche", new_admin_shipping_zone_shipping_method_shipping_rate_path(@zone, @shipping_method), class: "button button-small button-primary" %></div><% end %>
</section>
<section class="admin-section"><%= button_to "Supprimer la méthode", admin_shipping_zone_shipping_method_path(@zone, @shipping_method), method: :delete, class: "button button-danger", data: { turbo_confirm: "Supprimer cette méthode sans tarif ?" } %></section>
