<% content_for :title, t("quiz.results.title") %>
<section class="quiz-results shell"<% if @analytics_quiz_completed_event %> data-controller="quiz-analytics" data-quiz-analytics-completed-value="<%= @analytics_quiz_completed_event.to_json %>"<% end %>><div class="quiz-results-heading"><p class="eyebrow"><%= t("quiz.results.eyebrow") %></p><h1><%= @results.any? ? t("quiz.results.heading_matches") : t("quiz.results.heading_empty") %></h1><p><%= t("quiz.results.lead") %></p></div>
  <div class="recommendation-list"><% @results.each_with_index do |result, index| %><article class="recommendation-card"><div class="recommendation-rank">0<%= index + 1 %></div><div class="recommendation-image"><div class="product-visual has-image"><%= product_image(result.product) %></div></div><div class="recommendation-copy"><p class="eyebrow"><%= result.product.brand.name %></p><h2><%= result.product.name %></h2><p><%= translated_short_description(result.product) %></p><div class="match-reason"><strong><%= t("quiz.results.why") %></strong><span><%= t("quiz.results.because", reasons: result.reasons.to_sentence) %></span></div><div class="recommendation-bottom"><strong><%= money(result.product.minimum_price_cents) %></strong><%= link_to t("quiz.results.discover_cta"), product_path(result.product), class: "button button-primary" %></div></div></article><% end %></div>
  <div class="quiz-actions"><%= link_to t("quiz.results.edit_answers"), quiz_path, class: "button button-secondary" %><%= link_to t("quiz.results.see_catalog"), products_path, class: "text-link" %></div>
</section>
