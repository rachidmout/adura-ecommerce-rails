<% content_for :title, "#{t('carts.show.title')} · ADURA" %>
<% if @lines.empty? %><section class="cart-empty shell"><span>◇</span><p class="eyebrow"><%= t("carts.show.eyebrow") %></p><h1><%= t("carts.show.title_empty") %></h1><p><%= t("carts.show.empty_text") %></p><div class="button-row"><%= link_to t("carts.show.discover"), products_path, class: "button button-primary" %><%= link_to t("carts.show.find"), quiz_path, class: "button button-secondary" %></div></section><% else %>
<% analytics_cart_event = analytics_ecommerce_event(items: @lines.map { |line| analytics_ecommerce_item(product: line.product, variant: line.variant, quantity: line.quantity) }, value_cents: @subtotal_cents) %>
<section class="cart-page shell" data-controller="ecommerce-analytics" data-ecommerce-analytics-view-cart-value="<%= analytics_cart_event.to_json %>"<% if @analytics_promo_event %> data-ecommerce-analytics-promo-value="<%= @analytics_promo_event.to_json %>"<% end %>><div class="cart-title"><p class="eyebrow"><%= t("carts.show.selection") %></p><h1><%= t("carts.show.title") %></h1><p><%= t("layout.cart_items", count: cart_count) %></p></div><div class="cart-layout"><div class="cart-items"><% @lines.each do |line| %><article class="cart-item"><%= link_to product_path(line.product), class: "cart-item-image" do %><div class="product-visual has-image"><%= product_image(line.product) %></div><% end %><div class="cart-item-copy"><p class="eyebrow"><%= line.product.brand.name %></p><h2><%= link_to line.product.name, product_path(line.product) %></h2><p><%= line.variant.label %> · <%= translated_family_name(line.product.primary_family) %></p><strong><%= money(line.unit_price_cents) %></strong></div><div class="quantity-control"><%= form_with url: cart_item_path(line.variant), method: :patch, data: { controller: "cart-quantity", analytics_hook: "cart-quantity-control" } do |form| %><%= form.label :quantity, t("carts.show.quantity"), class: "sr-only" %><div class="quantity-stepper"><button type="button" data-cart-quantity-target="decrement" data-action="cart-quantity#decrement" aria-label="<%= t("carts.show.decrease_quantity") %>">−</button><%= form.select :quantity, 1..[line.variant.available_stock_quantity, 6].min, { selected: line.quantity }, { data: { cart_quantity_target: "select", action: "change->cart-quantity#sync" }, aria: { label: t("carts.show.quantity") } } %><button type="button" data-cart-quantity-target="increment" data-action="cart-quantity#increment" aria-label="<%= t("carts.show.increase_quantity") %>">+</button></div><% end %><%= button_to t("carts.show.remove"), cart_item_path(line.variant), method: :delete, class: "cart-remove-button", data: { analytics_hook: "cart-remove-item" }, form: { data: { action: "submit->ecommerce-analytics#removeFromCart", ecommerce_analytics_item: analytics_ecommerce_item(product: line.product, variant: line.variant, quantity: line.quantity).to_json } } %></div><strong class="cart-line-total"><%= money(line.line_total_cents) %></strong></article><% end %><%= link_to t("carts.show.keep_shopping"), products_path, class: "text-link" %></div><aside class="order-summary"><h2><%= t("carts.show.summary") %></h2><%= render "shared/promo_code_form" %><%= render "shared/order_summary_totals" %><%= render "shared/purchase_reassurance" %><%= link_to t("carts.show.checkout_cta"), new_checkout_path, class: "button button-primary checkout-button", data: { analytics_hook: "cart-checkout-cta" } %><p class="purchase-note"><%= t("carts.show.stripe_note") %></p></aside></div></section><div class="cart-sticky-checkout" data-analytics-hook="cart-checkout-cta"><div><span><%= @shipping_pending ? t("order_summary.total_excluding_shipping") : t("order_summary.total") %></span><strong><%= money(@total_cents) %></strong></div><%= link_to t("carts.show.checkout_sticky_cta"), new_checkout_path, class: "button button-primary", data: { analytics_hook: "cart-checkout-cta" } %></div><div class="cart-sticky-page-spacer" aria-hidden="true"></div><% end %>
