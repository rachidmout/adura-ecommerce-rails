<% content_for :title, t("static_pages.faq.title") %><section class="page-hero"><div class="shell"><p class="eyebrow"><%= t("static_pages.faq.eyebrow") %></p><h1><%= t("static_pages.faq.heading") %></h1><p><%= t("static_pages.faq.lead") %></p></div></section><section class="faq-list narrow page-content"><% (1..10).each do |i| %><details><summary><%= t("static_pages.faq.q#{i}") %><span>+</span></summary><p><%= t("static_pages.faq.a#{i}") %></p></details><% end %><div class="faq-contact"><h2><%= t("static_pages.faq.contact_title") %></h2><%= link_to t("static_pages.faq.contact_cta"), contact_path, class: "button button-primary" %></div></section>
