# Local development only. Never commit real credentials.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://adura:adura@localhost:5432/adura_development
TEST_DATABASE_URL=postgresql://adura:adura@localhost:5432/adura_test

# Optional local administrator. Choose your own credentials locally.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Application and mailer defaults
APP_HOST=localhost:3000
MAILER_FROM=hello@example.test

# Optional payment integration. Leave blank to explore non-payment flows.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional third-party integrations. Add real credentials only in your local .env
# SENDCLOUD_PUBLIC_KEY=
# SENDCLOUD_SECRET_KEY=
# MONDIAL_RELAY_BRAND_CODE=
# MONDIAL_RELAY_PRIVATE_KEY=
# GA4_PROPERTY_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
# ADURA_GROWTH_API_TOKEN=
# AI_MARKETING_API_TOKEN=
